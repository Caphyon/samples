<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Setup</AssemblyName>
    <!--
      The MSI has ALLUSERS=1 (per-machine install), so msiexec needs admin
      rights. This manifest makes the bootstrapper ask for elevation (UAC)
      right at startup, exactly like a real setup does.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Single-file publish settings: "dotnet publish -c Release" (or Publish
      from Visual Studio) produces ONE exe you can hand to users.
      SelfContained=false keeps it small but target machines need the
      .NET 8 Desktop Runtime; switch to true for a fully standalone
      (much larger) executable.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!--
    The MSI from the Payload folder is compiled INTO the executable as an
    embedded resource and extracted to %TEMP% at runtime. To ship a new
    version of DemoApp, just replace the file and rebuild.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Payload\**\*.msi" />
  </ItemGroup>

</Project>
