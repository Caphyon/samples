<Window x:Class="CustomInstallerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup"
        Height="420" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header band (the "banner" of the MSI dialogs) -->
        <Border Grid.Row="0" Background="{StaticResource AiHeaderBrush}"
                BorderBrush="{StaticResource AiOrange}" BorderThickness="0,0,0,3">
            <StackPanel VerticalAlignment="Center" Margin="24,0">
                <TextBlock x:Name="HeaderTitle" Text="Setup"
                           FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="HeaderSubtitle" Text="Preparing"
                           FontSize="12" Foreground="#FBB040" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- The current dialog (PrepareDlg, WelcomeDlg, FolderDlg, ...) -->
        <ContentControl x:Name="DialogHost" Grid.Row="1" Margin="24,20,24,12"/>

        <!-- Bottom button bar, shared by all dialogs like in a real MSI wizard -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="&lt; Back" Width="90" Height="30"
                        Style="{StaticResource AiSecondaryButton}"
                        IsEnabled="False" Click="BackButton_Click"/>
                <Button x:Name="NextButton" Content="Next &gt;" Width="90" Height="30"
                        Style="{StaticResource AiPrimaryButton}"
                        Margin="10,0,0,0" IsDefault="True" Click="NextButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="30"
                        Style="{StaticResource AiSecondaryButton}"
                        Margin="20,0,0,0" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
