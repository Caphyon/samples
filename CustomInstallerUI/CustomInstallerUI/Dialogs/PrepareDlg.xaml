<UserControl x:Class="CustomInstallerUI.Dialogs.PrepareDlg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <TextBlock TextWrapping="Wrap"
                   Text="Please wait while the Setup Wizard prepares to guide you through the installation."/>
        <ProgressBar Height="14" IsIndeterminate="True" Margin="0,16,0,0"
                     Style="{StaticResource AiProgressBar}"/>
    </StackPanel>
</UserControl>
