<UserControl x:Class="CustomInstallerUI.Dialogs.ExitDlg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#x2714;" FontSize="26" Foreground="#2E8B57"
                       Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="CompletedText" FontSize="15" TextWrapping="Wrap"
                       VerticalAlignment="Center" MaxWidth="430"
                       Text="Setup completed successfully."/>
        </StackPanel>
        <CheckBox x:Name="LaunchCheckBox" Content="Launch the application now"
                  IsChecked="True" Margin="38,18,0,0"/>
    </StackPanel>
</UserControl>
