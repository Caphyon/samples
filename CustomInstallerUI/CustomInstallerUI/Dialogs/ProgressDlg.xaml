<UserControl x:Class="CustomInstallerUI.Dialogs.ProgressDlg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="Please wait..."
                   Margin="0,0,0,10" TextWrapping="Wrap"/>
        <ProgressBar Height="18" IsIndeterminate="True"
                     Style="{StaticResource AiProgressBar}"/>
    </StackPanel>
</UserControl>
