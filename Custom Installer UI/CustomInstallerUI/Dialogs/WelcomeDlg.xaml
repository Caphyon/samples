<UserControl x:Class="CustomInstallerUI.Dialogs.WelcomeDlg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="WelcomeTitle" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource AiBlue}"
                   TextWrapping="Wrap" Text="Welcome to the Setup Wizard"/>
        <TextBlock x:Name="WelcomeBody" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="The Setup Wizard will install the application on your computer."/>
    </StackPanel>
</UserControl>
